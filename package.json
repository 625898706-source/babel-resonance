{
  "name": "babel-resonance",
  "version": "1.0.0",
  "description": "《巴别残响》英语学习 × 集成战略 Roguelike（Phaser 3）",
  "author": "babel",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "electron .",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.babel.resonance",
    "productName": "巴别残响",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BabelResonance-${version}.exe"
    }
  },
  "devDependencies": {
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^2.2.0",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {}
}
